			"expect": {"phase": "waiting", "files": ["bridge.lock", "r.req.json", "r.wait", "stale.res.json"]}
		},
		{
			"expect": {
				"calls": [{"tool": "ping"}],
				"responses": {"r": {"ok": true, "result": {}}},
				"files": ["bridge.lock", "r.res.json", "r.wait"]
			}
		}
	]
}
