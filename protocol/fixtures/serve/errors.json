{
	"description": "tools は道具の表を返す。表に無い道具は unknown_tool、道具の失敗は invalid_args と internal（例外を含む）で、道具が返した詳細だけを detail に載せる。値を返さない道具の result は {}、オブジェクトでない値を返す道具は internal。種類 write の道具は占有の中でだけ呼べる（占有されていなければ no_session）",
	"steps": [
		{"description": "ロックを取る（空のスプールなので何も消さない）", "expect": {"files": ["bridge.lock"]}},
		{
			"requests": {
				"tools": "tools.json",
				"unknown": "unknown.json",
				"bad-args": "bad-args.json",
				"bad-args-detail": "bad-args-detail.json",
				"broken": "broken-tool.json",
				"throws": "throws.json",
				"nothing": "nothing.json",
				"not-object": "not-object.json",
				"edit": "edit.json",
				"ping": "ping.json"
			},
			"expect": {
				"calls": [
					{"tool": "bad_args_detail"},
					{"tool": "bad_args"},
					{"tool": "broken"},
					{"tool": "not_object"},
					{"tool": "nothing"},
					{"tool": "ping"},
					{"tool": "throws"}
				],
				"responses": {
					"tools": {
						"ok": true,
						"result": {
							"protocol": 5,
							"tools": [
								{
									"name": "ping",
									"description": "生きているかを確かめる",
									"inputSchema": {
										"type": "object",
										"properties": {},
										"additionalProperties": false
									},
									"kind": "read"
								},
								{
									"name": "echo",
									"description": "引数をそのまま返す",
									"inputSchema": {"type": "object"},
									"kind": "read"
								},
								{
									"name": "edit",
									"description": "図面を変える道具の代わり",
									"inputSchema": {"type": "object"},
									"kind": "write"
								},
								{
									"name": "bad_args",
									"description": "引数の誤りで失敗する",
									"inputSchema": {"type": "object"},
									"kind": "read"
								},
								{
									"name": "broken",
									"description": "道具の中で失敗する",
									"inputSchema": {"type": "object"},
									"kind": "read"
								},
								{
									"name": "throws",
									"description": "道具の中で例外を投げる",
									"inputSchema": {"type": "object"},
									"kind": "read"
								},
								{
									"name": "nothing",
									"description": "値を返さない",
									"inputSchema": {"type": "object"},
									"kind": "read"
								},
								{
									"name": "not_object",
									"description": "オブジェクトでない値を返す",
									"inputSchema": {"type": "object"},
									"kind": "read"
								},
								{
									"name": "bad_args_detail",
									"description": "引数の誤りで失敗し、詳細を返す",
									"inputSchema": {"type": "object"},
									"kind": "read"
								},
								{
									"name": "save",
									"description": "図面のファイルに働き、終了は頼まない道具の代わり",
									"inputSchema": {"type": "object"},
									"kind": "app"
								},
								{
									"name": "quit_refused",
									"description": "終了を頼んでから失敗し、詳細を返す道具の代わり",
									"inputSchema": {"type": "object"},
									"kind": "app"
								},
								{
									"name": "quit",
									"description": "Vectorworks を終わらせる道具の代わり",
									"inputSchema": {
										"type": "object",
										"properties": {},
										"additionalProperties": false
									},
									"kind": "app"
								}
							]
						}
					},
					"unknown": {"ok": false, "code": "unknown_tool"},
					"bad-args": {"ok": false, "code": "invalid_args"},
					"bad-args-detail": {"ok": false, "code": "invalid_args", "detail": {"reason": "to_is_open"}},
					"broken": {"ok": false, "code": "internal"},
					"throws": {"ok": false, "code": "internal"},
					"nothing": {"ok": true, "result": {}},
					"not-object": {"ok": false, "code": "internal"},
					"edit": {"ok": false, "code": "no_session"},
					"ping": {"ok": true, "result": {}}
				},
				"files": [
					"bad-args-detail.res.json",
					"bad-args-detail.wait",
					"bad-args.res.json",
					"bad-args.wait",
					"bridge.lock",
					"broken.res.json",
					"broken.wait",
					"edit.res.json",
					"edit.wait",
					"not-object.res.json",
					"not-object.wait",
					"nothing.res.json",
					"nothing.wait",
					"ping.res.json",
					"ping.wait",
					"throws.res.json",
					"throws.wait",
					"tools.res.json",
					"tools.wait",
					"unknown.res.json",
					"unknown.wait"
				]
			}
		}
	]
}
