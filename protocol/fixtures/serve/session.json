{
	"description": "占有（通信規則「占有」の表）。$session は発行された印に置き換える",
	"steps": [
		{
			"description": "ロックを取る（空のスプールなので何も消さない）",
			"expect": {"files": ["bridge.lock"]}
		},
		{
			"description": "誰も占有していない。session_end と種類 write・app は no_session、印を載せた session_start も no_session。種類 read は印を見ずに実行する",
			"requests": {
				"1-quit": "quit.json",
				"2-end": "session-end.json",
				"3-end-other": "session-end-other-session.json",
				"4-echo-other": "echo-other-session.json",
				"5-start-with-session": "session-start-with-session.json",
				"6-edit": "edit.json",
				"7-edit-other": "edit-other-session.json"
			},
			"expect": {
				"calls": [{"tool": "echo", "args": {}}],
				"responses": {
					"1-quit": {"ok": false, "code": "no_session"},
					"2-end": {"ok": false, "code": "no_session"},
					"3-end-other": {"ok": false, "code": "no_session"},
					"4-echo-other": {"ok": true, "result": {}},
					"5-start-with-session": {"ok": false, "code": "no_session"},
					"6-edit": {"ok": false, "code": "no_session"},
					"7-edit-other": {"ok": false, "code": "no_session"}
				},
				"files": [
					"1-quit.res.json",
					"1-quit.wait",
					"2-end.res.json",
					"2-end.wait",
					"3-end-other.res.json",
					"3-end-other.wait",
					"4-echo-other.res.json",
					"4-echo-other.wait",
					"5-start-with-session.res.json",
					"5-start-with-session.wait",
					"6-edit.res.json",
					"6-edit.wait",
					"7-edit-other.res.json",
					"7-edit-other.wait",
					"bridge.lock"
				]
			}
		},
		{
			"description": "印を発行する",
			"requests": {"start": "session-start.json"},
			"expect": {
				"responses": {"start": {"ok": true, "result": {"session": "$session"}}},
				"files": ["bridge.lock", "start.res.json", "start.wait"]
			}
		},
		{
			"description": "占有されている。session_start と、その印の無い session_end・種類 write・app は occupied。種類 read と tools は誰にでも答え、表に無い道具は占有に照らさずに unknown_tool",
			"requests": {
				"a-start": "session-start.json",
				"b-echo": "echo.json",
				"c-echo-other": "echo-other-session.json",
				"d-quit": "quit.json",
				"e-quit-other": "quit-other-session.json",
				"f-end": "session-end.json",
				"g-end-other": "session-end-other-session.json",
				"h-unknown": "unknown.json",
				"i-ping": "ping.json",
				"j-ping-other": "ping-other-session.json",
				"k-tools-other": "tools-other-session.json",
				"l-echo": "echo-in-session.json",
				"m-edit": "edit-in-session.json",
				"n-unknown": "unknown-in-session.json",
				"o-edit": "edit.json",
				"p-edit-other": "edit-other-session.json"
			},
			"expect": {
				"calls": [
					{"tool": "echo", "args": {"include_sheets": false, "limit": 50, "layer": "1F"}},
					{"tool": "echo", "args": {}},
					{"tool": "ping"},
					{"tool": "ping"},
					{"tool": "echo", "args": {}},
					{"tool": "edit", "args": {}}
				],
				"responses": {
					"a-start": {"ok": false, "code": "occupied"},
					"b-echo": {"ok": true},
					"c-echo-other": {"ok": true, "result": {}},
					"d-quit": {"ok": false, "code": "occupied"},
					"e-quit-other": {"ok": false, "code": "occupied"},
					"f-end": {"ok": false, "code": "occupied"},
					"g-end-other": {"ok": false, "code": "occupied"},
					"h-unknown": {"ok": false, "code": "unknown_tool"},
					"i-ping": {"ok": true, "result": {}},
					"j-ping-other": {"ok": true, "result": {}},
					"k-tools-other": {"ok": true},
					"l-echo": {"ok": true, "result": {}},
					"m-edit": {"ok": true, "result": {}},
					"n-unknown": {"ok": false, "code": "unknown_tool"},
					"o-edit": {"ok": false, "code": "occupied"},
					"p-edit-other": {"ok": false, "code": "occupied"}
				},
				"files": [
					"a-start.res.json",
					"a-start.wait",
					"b-echo.res.json",
					"b-echo.wait",
					"bridge.lock",
					"c-echo-other.res.json",
					"c-echo-other.wait",
					"d-quit.res.json",
					"d-quit.wait",
					"e-quit-other.res.json",
					"e-quit-other.wait",
					"f-end.res.json",
					"f-end.wait",
					"g-end-other.res.json",
					"g-end-other.wait",
					"h-unknown.res.json",
					"h-unknown.wait",
					"i-ping.res.json",
					"i-ping.wait",
					"j-ping-other.res.json",
					"j-ping-other.wait",
					"k-tools-other.res.json",
					"k-tools-other.wait",
					"l-echo.res.json",
					"l-echo.wait",
					"m-edit.res.json",
					"m-edit.wait",
					"n-unknown.res.json",
					"n-unknown.wait",
					"o-edit.res.json",
					"o-edit.wait",
					"p-edit-other.res.json",
					"p-edit-other.wait"
				]
			}
		},
		{
			"description": "占有を終える",
			"requests": {"end": "session-end-in-session.json"},
			"expect": {
				"responses": {"end": {"ok": true, "result": {"ended": true}}},
				"files": ["bridge.lock", "end.res.json", "end.wait"]
			}
		},
		{
			"description": "終えた印を載せた種類 write は no_session、種類 read は印を見ずに実行する。同じ回の中でも、発行した印はその後の要求に効く",
			"requests": {
				"a-echo": "echo-in-session.json",
				"b-edit": "edit-in-session.json",
				"c-echo": "echo-no-args.json",
				"d-start": "session-start.json",
				"e-edit": "edit.json"
			},
			"expect": {
				"calls": [{"tool": "echo"}, {"tool": "echo"}],
				"responses": {
					"a-echo": {"ok": true, "result": {}},
					"b-edit": {"ok": false, "code": "no_session"},
					"c-echo": {"ok": true, "result": {}},
					"d-start": {"ok": true, "result": {"session": "$session"}},
					"e-edit": {"ok": false, "code": "occupied"}
				},
				"files": [
					"a-echo.res.json",
					"a-echo.wait",
					"b-edit.res.json",
					"b-edit.wait",
					"bridge.lock",
					"c-echo.res.json",
					"c-echo.wait",
					"d-start.res.json",
					"d-start.wait",
					"e-edit.res.json",
					"e-edit.wait"
				]
			}
		}
	]
}
