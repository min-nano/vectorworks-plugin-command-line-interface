{
	"protocol": 5,
	"app_dir_name": "vectorworks2026-cli",
	"spool_dir_name": "spool",
	"lock_file": "bridge.lock",
	"request_suffix": ".req.json",
	"response_suffix": ".res.json",
	"wait_suffix": ".wait",
	"temp_suffix": ".tmp",
	"max_request_bytes": 1048576,
	"max_nesting_depth": 64,
	"max_id_length": 64,
	"valid_ids": ["a", "A_z-9", "1760000000000000000-0a1b2c3d", "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"],
	"invalid_ids": ["", "a.b", "../a", "a b", "a/b", "あ", "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"],
	"reserved_tools": ["tools", "ping", "session_start", "session_end"],
	"codes": ["invalid_request", "unknown_tool", "invalid_args", "no_wait", "busy", "no_session", "internal"],
	"kinds": ["read", "write", "app"]
}
