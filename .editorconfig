# EditorConfig - https://editorconfig.org
#
# The baseline whitespace and encoding rules for every text file, checked by
# editorconfig-checker (lint.yml). The formatters (gofmt, clang-format,
# cmake-format) own the layout of their files.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Tabs everywhere they are allowed, 4 columns wide: gofmt can only
# indent Go with tabs, so the other languages follow. Lines up to 100 columns
# (a tab counts 4); the formatters wrap C/C++ and CMake, editorconfig-checker
# checks shell and Python. gofmt does not limit Go lines.
[{*.go,go.mod,*.c,*.cpp,*.h,*.hpp,*.mm,CMakeLists.txt,*.cmake,*.sh,*.py,*.ps1,*.json}]
indent_style = tab
indent_size = 4
tab_width = 4

[{*.sh,*.py}]
max_line_length = 100

# YAML cannot be indented with tabs: 2 spaces.
[*.{yml,yaml}]
indent_style = space
indent_size = 2

# Markdown: keep trailing whitespace (it is a hard line break in Markdown).
[*.md]
trim_trailing_whitespace = false
