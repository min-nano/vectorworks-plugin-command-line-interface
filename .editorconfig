# EditorConfig - https://editorconfig.org
#
# The baseline whitespace and encoding rules for every text file, checked by
# editorconfig-checker (lint.yml). The formatters (gofmt, clang-format,
# cmake-format) own the layout of their files.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Go: tabs, as gofmt writes them (it has no option for spaces), shown 4 columns
# wide like the 4-space indentation of the other languages.
[{*.go,go.mod}]
indent_style = tab
indent_size = 4
tab_width = 4

# C/C++, CMake, shell and Python: 4 spaces, lines up to 100 columns (the
# formatters wrap C/C++ and CMake; editorconfig-checker checks shell and Python).
[{*.c,*.cpp,*.h,*.hpp,*.mm,CMakeLists.txt,*.cmake,*.sh,*.py,*.ps1}]
indent_style = space
indent_size = 4
max_line_length = 100

# Data files: 2 spaces (the YAML and JSON already in the repository).
[*.{yml,yaml,json}]
indent_style = space
indent_size = 2

# Markdown: keep trailing whitespace (it is a hard line break in Markdown).
[*.md]
trim_trailing_whitespace = false
