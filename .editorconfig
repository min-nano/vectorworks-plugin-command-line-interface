# EditorConfig - https://editorconfig.org
#
# The baseline whitespace and encoding rules for every text file, checked by
# editorconfig-checker (lint.yml). The formatters (gofmt, clang-format,
# cmake-format) own the layout of their files.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Indentation follows gofmt (cli/): tabs, shown 2 columns wide. clang-format,
# cmake-format and gofmt are the source of truth for the layout.
[{*.go,go.mod,*.c,*.cpp,*.h,*.hpp,*.mm,CMakeLists.txt,*.cmake,*.sh,*.py}]
indent_style = tab
indent_size = 2
tab_width = 2

# Data files and PowerShell: 2 spaces (YAML cannot use tabs).
[*.{yml,yaml,json,ps1}]
indent_style = space
indent_size = 2

# Markdown: keep trailing whitespace (it is a hard line break in Markdown).
[*.md]
trim_trailing_whitespace = false
