# 言語共通の整形の規則（docs/format.md）。各言語の設定には、その言語固有の項目のみを記述する。
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab
indent_size = 4
max_line_length = 100

# YAML はタブを使用できない。Markdown はリストの入れ子をスペースで記述する。
[*.{yml,yaml,md}]
indent_style = space
indent_size = 2

# 長い表と日本語の段落を折り返さない。
[*.md]
max_line_length = off

# PowerShell は BOM 付き。Windows PowerShell 5.1 は BOM の無いファイルを ANSI のコードページで
# 読み取り、日本語のコメントや文字列を誤って解釈するため。
[*.{ps1,psm1,psd1}]
charset = utf-8-bom

# Vectorworks のリソースの文字列。UTF-16LE（BOM 付き）・CRLF のまま保持する。
[*.vwstrings]
charset = utf-16le
end_of_line = crlf
insert_final_newline = unset
trim_trailing_whitespace = unset

# 通信規則のフィクスチャ。不正な要求を意図的に含むため、エディタに内容を変更させない。
[protocol/fixtures/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset
