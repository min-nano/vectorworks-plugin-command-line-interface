# clang-format configuration for the cli Vectorworks plug-in (src/, tests/).
#
# The layout follows gofmt, the formatter of the Go half of this repository
# (cli/), where gofmt leaves a choice, and the repository-wide rules elsewhere:
#   * tabs for indentation and continued lines, spaces only for alignment, as
#     gofmt does; a tab is 4 columns wide (.editorconfig),
#   * one more indentation for a continued line, no alignment after an open bracket,
#   * braces on the same line, case labels at the level of the switch,
#   * namespace bodies not indented (Go has no nesting at the top level),
#   * lines wrapped at 100 columns (comments are left to the author),
#   * includes sorted within each block (gofmt sorts imports within a group).
#
# Format a file in place:            clang-format -i src/core/Json.cpp
# Check without writing (CI does):   clang-format --dry-run --Werror src/core/*.cpp
# Or run scripts/lint.sh (--fix to format in place).
Language: Cpp
BasedOnStyle: LLVM

# --- Indentation ------------------------------------------------------------
UseTab: ForContinuationAndIndentation
TabWidth: 4
IndentWidth: 4
ContinuationIndentWidth: 4
NamespaceIndentation: None
AccessModifierOffset: -4
IndentPPDirectives: AfterHash
IndentCaseLabels: false
AlignAfterOpenBracket: DontAlign

# --- Braces -----------------------------------------------------------------
BreakBeforeBraces: Attach

# --- Pointers / references bind to the type ---------------------------------
PointerAlignment: Left
ReferenceAlignment: Left
DerivePointerAlignment: false

# --- Line width -------------------------------------------------------------
ColumnLimit: 100
ReflowComments: false

# --- Includes ---------------------------------------------------------------
SortIncludes: CaseSensitive
IncludeBlocks: Preserve

# --- Misc ---------------------------------------------------------------------
FixNamespaceComments: true
SpaceAfterCStyleCast: false
AllowShortFunctionsOnASingleLine: Empty
AllowShortIfStatementsOnASingleLine: false
AllowShortLoopsOnASingleLine: false
EmptyLineBeforeAccessModifier: LogicalBlock
KeepEmptyLinesAtTheStartOfBlocks: false
