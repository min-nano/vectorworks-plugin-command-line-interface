# clang-format configuration for the cli Vectorworks plug-in (src/, tests/).
#
# The layout follows gofmt, the formatter of the Go half of this repository
# (cli/), so that the two languages read the same:
#   * tabs for indentation, spaces for alignment (gofmt), a tab shown as 2 columns
#     (.editorconfig),
#   * one more tab for a continued line, no alignment after an open bracket,
#   * braces on the same line, case labels at the level of the switch,
#   * namespace bodies not indented (Go has no nesting at the top level),
#   * no line-length limit: like gofmt, the author decides where a long line
#     breaks, and the formatter keeps those breaks,
#   * includes sorted within each block (gofmt sorts imports within a group).
#
# Format a file in place:            clang-format -i src/core/Json.cpp
# Check without writing (CI does):   clang-format --dry-run --Werror src/core/*.cpp
# Or run scripts/lint.sh (--fix to format in place).
Language: Cpp
BasedOnStyle: LLVM

# --- Indentation ------------------------------------------------------------
UseTab: ForIndentation
TabWidth: 2
IndentWidth: 2
ContinuationIndentWidth: 2
NamespaceIndentation: None
AccessModifierOffset: -2
IndentPPDirectives: AfterHash
IndentCaseLabels: false
AlignAfterOpenBracket: DontAlign

# --- Braces -----------------------------------------------------------------
BreakBeforeBraces: Attach

# --- Pointers / references bind to the type ---------------------------------
PointerAlignment: Left
ReferenceAlignment: Left
DerivePointerAlignment: false

# --- Line width -------------------------------------------------------------
ColumnLimit: 0
ReflowComments: false

# --- Includes ---------------------------------------------------------------
SortIncludes: CaseSensitive
IncludeBlocks: Preserve

# --- Misc ---------------------------------------------------------------------
FixNamespaceComments: true
SpaceAfterCStyleCast: false
AllowShortFunctionsOnASingleLine: Empty
AllowShortIfStatementsOnASingleLine: false
AllowShortLoopsOnASingleLine: false
EmptyLineBeforeAccessModifier: LogicalBlock
KeepEmptyLinesAtTheStartOfBlocks: false
